# ==========================================
# Variables de Entorno — Ecommerce Premium
# ==========================================
# Copia este archivo a .env en tu carpeta raíz
# No commits el .env real a git, solo .env.example

# ==========================================
# BACKEND (Strapi)
# ==========================================

# Base de datos MySQL
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=ecommerce_db
DATABASE_USERNAME=root
DATABASE_PASSWORD=tu_contraseña_mysql

# Strapi Admin
STRAPI_ADMIN_JWT_SECRET=tu_secreto_jwt_muy_largo_y_aleatorio_aqui
STRAPI_API_TOKEN_SALT=tu_salt_para_tokens_api_aqui

# Cloudinary (imágenes)
CLOUDINARY_NAME=tu_cloud_name_aqui
CLOUDINARY_KEY=tu_api_key_aqui
CLOUDINARY_SECRET=tu_api_secret_aqui
CLOUDINARY_FOLDER=dev  # Cambiar a "produccion" en servidor real

# Wompi (pagos - Colombia)
WOMPI_PUBLIC_KEY=pub_test_xxxxx  # pub_test_xxx en sandbox, pub_prod_xxx en producción
WOMPI_PRIVATE_KEY=prv_test_xxxxx  # prv_test_xxx en sandbox, prv_prod_xxx en producción
WOMPI_WEBHOOK_SECRET=tu_webhook_secret_de_wompi
WOMPI_SANDBOX_MODE=true  # Cambiar a false en producción

# Sentry (monitoreo de errores)
SENTRY_DSN_BACKEND=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# Entorno
NODE_ENV=development  # development, staging, production

# ==========================================
# FRONTEND (Nuxt)
# ==========================================

# URL de la API de Strapi
NUXT_PUBLIC_API_URL=http://localhost:1337

# URL del sitio (para redirecciones, cookies, etc.)
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Sentry (monitoreo de errores en navegador)
NUXT_PUBLIC_SENTRY_DSN_FRONTEND=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# Entorno
NUXT_PUBLIC_ENV=development  # development, staging, production

# ==========================================
# CÓMO COMPLETAR ESTE ARCHIVO
# ==========================================
# 1. Copia este archivo a `.env` en la raíz de tu proyecto
# 2. Completa cada valor con tus credenciales reales
# 3. Nunca commits `.env` a git (déjalo en .gitignore)
# 4. Mantén `.env.example` actualizado en git, sin valores reales
# 
# Para cada servicio:
# - MySQL: instala localmente o usa Railway/Render para obtener credenciales
# - Cloudinary: crea cuenta en cloudinary.com, obtén credentials del dashboard
# - Wompi: crea cuenta comercial, obtén keys de sandbox para pruebas
# - Sentry: crea proyecto en sentry.io, obtén el DSN de cada proyecto
